# Environment: development | production
NODE_ENV=production

# Server Port (Railway assigns PORT automatically, but set a default)
PORT=5002

# Frontend URL for CORS (set to your production Firebase hosting or domain)
FRONTEND_URL=https://tajskyviewresidences.co.in

# Google Sheets Configuration
# Get GOOGLE_SHEET_ID from the URL of your Google Sheet (the long alphanumeric ID)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account Credentials (Option 1 - recommended for Railway)
# Paste the full JSON from Google Cloud Console > Service Accounts > Create Key (JSON)
# This is the most reliable way to deploy on Railway
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Alternative: Path to service account JSON file (for local use only)
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json

# Secret Token for form submission authentication (optional, for CSRF protection)
SECRET_TOKEN=your_secret_token_here

# CORS Origins (comma-separated)
CORS_ORIGIN=https://tajskyviewresidences.co.in

# Gmail SMTP Configuration for Email Notifications
# Create an app password for the Gmail account used to receive notifications
GMAIL_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Recipient email for form submissions
RECIPIENT_EMAIL=your_email@gmail.com

# Secret Token (for optional CSRF protection)
SECRET_TOKEN=your_secret_token_here
